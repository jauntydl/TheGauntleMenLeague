# Self-serve signups (/join) commit to the repo. Without these, POST /api/join
# answers 503 "not configured" and the rest of the site works as normal.
#
# Create a fine-grained personal access token scoped to THIS repository only,
# with Repository permissions -> Contents: Read and write. Nothing else.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
# Optional; defaults to main.
GITHUB_BRANCH=main

# Optional. A Discord incoming webhook; every successful signup posts one line
# to it ("🆕 **Name** joined the board — …"). Unset means no notification.
# Discord: channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
JOIN_WEBHOOK_URL=

# The owner's hidden manual refresh (tap "Stats read …" on the board five times).
# Without it every attempt is refused. Set it in Vercel, never in this file.
# The GITHUB_TOKEN above also needs Repository permissions -> Actions: Read and
# write for this, since it starts the refresh workflow.
REFRESH_PASSWORD=
